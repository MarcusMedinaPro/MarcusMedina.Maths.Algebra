<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MarcusMedina.Maths.Algebra</RootNamespace>

    <!-- NuGet Package Metadata -->
    <PackageId>MarcusMedina.Maths.Algebra</PackageId>
    <Version>0.3.3</Version>
    <Authors>Marcus Medina</Authors>
    <Company>MarcusMedina</Company>
    <Product>FluentBuilders</Product>
    <Description>Fluent API for algebraic expressions, symbolic math, and equation solving in C#</Description>
    <Copyright>Copyright © Marcus Medina 2019-2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Maths.Algebra/wiki</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MarcusMedinaPro/MarcusMedina.Maths.Algebra</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>algebra;math;symbolic;fluent;expressions;equations</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <CollectCoverage>true</CollectCoverage>
    <CoverageFormat>cobertura</CoverageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\..\assets\open-source.svg" Pack="true" PackagePath="assets\" />
  </ItemGroup>

</Project>
